{
  "manifest_version": 3,
  "name": "WebAuthn SSH Agent",
  "version": "0.2.6",
  "description": "SSH agent for Chrome's Secure Shell, with SSH keys bound to security keys (FIDO2/U2F) or passkeys, via WebAuthn.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "137",
  "key": "",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {},
  "options_ui": {
    "page": "src/manage.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "externally_connectable": {
    "ids": [
      "iodihamcpbpeioajjeobimgagajmlibd",
      "algkcnfjnajfhgimadimbjhmpaeohhln"
    ],
    "matches": [
      "chrome-untrusted://terminal/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
